<?xml version="1.0" encoding="utf-8"?>
<!--
  The shop server is usually reached by LAN IP over plain http, so cleartext
  has to be allowed. Android blocks it by default from API 28.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

DATABASE_URL=postgresql://skywin:skywin@localhost:5432/skywin_bill
INTERAKT_SECRET_KEY=
INTERAKT_OTP_TEMPLATE=skywin_otp
# Admin login for 9999999999 (escape $ as $$ in Docker Compose env files)
ADMIN_PASSWORD=change-me
# Used to HMAC-sign skywin_session. Set a long random value in production.
SESSION_SECRET=change-me-session-secret
# WhiteBooks GSP (e-Invoice / e-Way Bill). Secrets live here, never in the
# settings table. WHITEBOOKS_ENV=sandbox until sandbox auth is confirmed.
WHITEBOOKS_ENV=sandbox
WHITEBOOKS_CLIENT_ID=
WHITEBOOKS_CLIENT_SECRET=
WHITEBOOKS_GST_USERNAME=
WHITEBOOKS_GST_PASSWORD=
WHITEBOOKS_GSTIN=
WHITEBOOKS_EMAIL=
WHITEBOOKS_IP_ADDRESS=
